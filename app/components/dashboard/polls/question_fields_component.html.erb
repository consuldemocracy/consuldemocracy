<div class="question-fields nested-fields">
  <%= form.hidden_field :author_id, value: question.author_id || current_user.id %>
  <%= form.hidden_field :proposal_id, value: proposal.id %>
  <div class="row expanded">
    <div class="small-12 large-9 column">
      <%= form.text_field :title %>
    </div>
    <div class="small-12 large-3 column margin-top">
      <%= link_to_remove_association form, class: "delete" do %>
        <%= t("dashboard.polls.question_fields.remove_question") %>
      <% end %>
    </div>
  </div>

  <div class="js-options">
    <%= form.fields_for :question_options do |option_form| %>
      <%= render Dashboard::Polls::QuestionOptionFieldsComponent.new(option_form) %>
    <% end %>

    <div class="option-links links row expanded">
      <div class="small-12 column">
        <%= link_to_add_association t("dashboard.polls.question_fields.add_answer"),
                                    form, :question_options, class: "button hollow" %>
      </div>
    </div>
  </div>
</div>
