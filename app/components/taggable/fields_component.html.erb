<fieldset class="taggable-fields">
  <%= content_tag(:legend,
                  class: ("taggable-fields-heading taggable-fields-heading-with-suggest" if show_ai_suggestions?)) do %>
    <%= categories.any? ? t("shared.categories_and_tags_label") : tags_label %>
    <% if show_ai_suggestions? %>
      <%= button_tag t("classification_suggestions.suggest_tags"),
                     type: "button",
                     class: "button small suggest-classification",
                     data: suggest_button_data %>
    <% end %>
  <% end %>

  <p class="help-text" id="tag-list-help-text"><%= tags_instructions %></p>

  <% if categories.any? %>
    <fieldset id="category_tags" class="tags">
      <legend class="show-for-sr"><%= tag_category_label %></legend>
      <% categories.each do |category| %>
        <% name = category_name(category) %>
        <% checkbox_id = "tag_category_#{name.parameterize}" %>
        <%= check_box_tag nil, name, category_selected?(name),
                          id: checkbox_id,
                          data: { list_value: name } %>
        <%= label_tag checkbox_id, name %>
      <% end %>
    </fieldset>
  <% end %>

  <%= form.text_field :tag_list, value: tag_list_value,
                                 label: tags_label,
                                 label_options: { class: "show-for-sr" },
                                 hint: tags_placeholder,
                                 data: tag_list_data %>

  <% if show_ai_suggestions? %>
    <div class="classification-suggestions-tags classification-suggestions hide"
         role="region"
         aria-label="<%= t("classification_suggestions.tags_region") %>"
         data-title="<%= t("classification_suggestions.tags_title") %>"
         data-accept-all="<%= t("classification_suggestions.accept_all") %>"
         data-close="<%= t("classification_suggestions.close") %>"
         data-loading="<%= t("classification_suggestions.loading") %>"
         data-empty="<%= t("classification_suggestions.empty") %>"
         data-error="<%= t("classification_suggestions.error") %>">
      <div class="classification-suggestions-body"></div>
      <%= render "shared/classification_suggestion_template" %>
    </div>
  <% end %>
</fieldset>
