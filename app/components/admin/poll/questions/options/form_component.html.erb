<%= render "shared/globalize_locales", resource: option %>

<%= translatable_form_for(option, url: url) do |f| %>

  <%= render "shared/errors", resource: option %>

  <div class="row">
    <%= f.translatable_fields do |translations_form| %>
      <div class="column end">
        <%= translations_form.text_field :title %>
      </div>
      <div class="column">
        <%= translations_form.text_area :description, maxlength: Poll::Question.description_max_length, class: "html-area" %>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="column medium-6">
      <%= f.number_field :given_order, min: 1, value: option.given_order_or_last %>
    </div>
    <div class="column">
      <%= f.check_box :allow_custom_text, aria: { describedby: allow_custom_text_help_id(f) } %>
      <span class="help-text" id="<%= allow_custom_text_help_id(f) %>">
        <%= t("admin.questions.show.answers.allow_custom_text.help") %>
      </span>
    </div>
  </div>

  <div class="row">
    <div class="small-12 medium-4 large-2 margin-top column">
      <%= f.submit(class: "button success expanded", value: t("shared.save")) %>
    </div>
  </div>

<% end %>
